{
  "name": "reservations-restaurants",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:real": "vite dev --mode real",
    "build": "vite build && node scripts/post-build.ts",
    "build:e2e": "vite build --mode test && node scripts/post-build.ts",
    "serve": "node scripts/serve-pages.ts --root dist/client --port 4311 --port-env E2E_REACT_PORT",
    "serve:legacy": "node scripts/serve-pages.ts --root legacy --port 4310 --port-env E2E_LEGACY_PORT",
    "typecheck": "tsc",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix && oxfmt --disable-nested-config",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --disable-nested-config --check",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --ignore 'src/**/*.test.{ts,tsx}' --ignore 'src/**/*.stories.tsx' --ignore 'src/test/**' --throws --preserve-whitespace --out-file translations/fr.json",
    "test": "vitest run",
    "test:node": "vitest run --project node --project node-ny",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "test:e2e:legacy": "playwright test --project legacy",
    "budget": "node scripts/check-budget.ts",
    "knip": "knip && knip --production",
    "check:fast": "pnpm i18n:extract && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:node",
    "check": "pnpm i18n:extract && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/work-sans": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.3",
    "valibot": "1.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@formatjs/cli": "6.16.32",
    "@formatjs/unplugin": "1.2.12",
    "@msw/playwright": "0.7.0",
    "@playwright/test": "1.63.0",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "eslint-plugin-formatjs": "8.1.0",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "msw": "3.0.2",
    "oxc-transform-react": "0.145.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.8.1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
