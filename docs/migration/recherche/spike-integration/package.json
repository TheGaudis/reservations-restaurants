{
  "name": "spike-reservations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/post-build.ts",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "knip": "knip",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --ignore 'src/**/*.test.{ts,tsx}' --ignore 'src/**/*.stories.tsx' --ignore 'src/test/**' --throws --preserve-whitespace --out-file translations/fr.json && oxfmt translations/fr.json",
    "check": "pnpm i18n:extract && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm knip --production && pnpm build && node scripts/check-budget.ts && pnpm test:e2e && pnpm build-storybook"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.3",
    "valibot": "1.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@formatjs/cli": "6.16.32",
    "@formatjs/unplugin": "1.2.12",
    "@msw/playwright": "0.7.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "eslint-plugin-formatjs": "8.1.0",
    "knip": "6.39.0",
    "msw": "3.0.2",
    "msw-storybook-addon": "3.0.3",
    "oxc-transform-react": "0.145.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "storybook": "10.6.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "packageManager": "pnpm@12.8.1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
