{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts"],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/mocks/**!",
    "!src/test/**!",
    "!src/intl/common-messages.ts!", // retirer en P4 (a), qui l'importe dans la page
    "!src/ui/**!", // retirer quand chaque composant de ui/ a un importeur de production (P7 (a) au plus tard)
    "!src/domain/**!", // retirer en P6 (b) : domain/ (P2 (a)) attend ses importeurs de production (api/, features/)
    // retirer en P4 (c) au plus tard : api/ (P2 (b1)) attend ses importeurs de production (queries/, mutations/)
    "!src/api/{errors,hedged-read,request-id,schemas,signals,staff-schemas,state,transport}.ts!",
    "e2e/**/*.ts",
    "scripts/*.ts",
    ".storybook/*.{ts,tsx}"
  ],
  // Le plugin Vitest de knip lirait les tests des projets copiés dans docs/migration/recherche/
  "ignore": ["docs/**"],
  "ignoreDependencies": [
    // Lues par url() dans src/styles/base.css, que knip n'analyse pas
    "@fontsource-variable/outfit",
    "@fontsource-variable/work-sans",
    // Temporaire : paquets installés en P0 (a), importés par une phase suivante
    "zustand" // retirer en P2 (c)
  ]
}
