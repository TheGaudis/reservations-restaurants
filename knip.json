{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts"],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/mocks/**!",
    "!src/test/**!",
    "!src/intl/staff-messages.ts!", // retirer en P5 : textes partagés du mode collègue (P4 (a))
    "!src/ui/**!", // retirer quand chaque composant de ui/ a un importeur de production (P7 (a) au plus tard)
    "!src/domain/**!", // retirer en P6 (b) : domain/ (P2 (a)) attend ses importeurs de production (api/, features/)
    // retirer en P5 : actions et schémas du mode collègue (P2 (b1), P2 (b2)), sans importeur de production avant P5
    "!src/api/{actions,errors,schemas,staff-schemas,transport}.ts!",
    "!src/intl/amounts.ts!", // retirer en P4 (d) : totaux et récapitulatifs des formulaires (P4 (c), P4 (d))
    "e2e/**/*.ts",
    "scripts/*.ts",
    ".storybook/*.{ts,tsx}"
  ],
  // Le plugin Vitest de knip lirait les tests des projets copiés dans docs/migration/recherche/
  "ignore": ["docs/**"],
  "ignoreDependencies": [
    // Lues par url() dans src/styles/base.css, que knip n'analyse pas
    "@fontsource-variable/outfit",
    "@fontsource-variable/work-sans"
  ]
}
